      "parameters": {
        "jsCode": "const inventory = $input.all().map(x=>x.json).filter(x => String(x.Status).toLowerCase() === 'available'); return [{json:{profile:$('Parse Collector Profile').item.json,inquiry:$('Normalize Inquiry').item.json,inventory}}];"
