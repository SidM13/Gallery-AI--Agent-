      "typeVersion": 1.2,
      "position": [
        -300,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().slice(0, 150).map(({json}) => ({json:{title:json.title ?? '',link:json.link ?? '',published:json.isoDate ?? json.pubDate ?? '',summary:(json.contentSnippet ?? json.content ?? '').slice(0,1200)}}));"
      },
      "id": "gallery-16",
      "name": "Limit and Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Configuration').item.json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Artists",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {},
