      "id": "gallery-17",
      "name": "Read Artists",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [
        120,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "Rq86CkeCagQw7w4N",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const opportunities = $('Limit and Normalize').all().map(x => x.json); const artists = $input.all().map(x => x.json); return [{json:{opportunities,artists}}];"
      },
      "id": "gallery-18",
      "name": "Bundle Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').item.json.ollamaUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: $('Configuration').item.json.model, stream: false, think: false, format: 'json', prompt: `Match only relevant, future-dated opportunities to represented artists. Respect stated geography and medium. Never invent a deadline. Return JSON only: {\"matches\":[{\"title\":\"\",\"link\":\"\",\"deadline\":\"\",\"matchedArtist\":\"\",\"reason\":\"\"}]}. Data: ${JSON.stringify($json)}` } }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "gallery-19",
      "name": "Match Opportunities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.response ?? $json.data?.response;\nif (!raw) throw new Error('Ollama returned no response');\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch { throw new Error('Ollama response was not valid JSON: ' + raw.slice(0, 200)); }\nif (!Array.isArray(parsed.matches)) throw new Error('Missing matches array');\nreturn [{ json: parsed }];"
      },
      "id": "gallery-20",
      "name": "Parse Matches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "matches",
        "options": {}
      },
      "id": "gallery-21",
      "name": "One Item Per Match",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1000,
        -80
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Configuration').item.json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Opportunities",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Link": "={{ $json.link }}",
            "Title": "={{ $json.title }}",
            "Deadline": "={{ $json.deadline }}",
            "Matched_Artist": "={{ $json.matchedArtist }}",
            "Status": "New"
          },
          "matchingColumns": [
            "Link"
          ],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "gallery-22",
      "name": "Save Opportunity",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [
        1220,
        -80
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "Rq86CkeCagQw7w4N",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const matches = $('Parse Matches').item.json.matches; const lines = matches.length ? matches.map(m => `• ${m.title}\\n  Artist: ${m.matchedArtist}\\n  Deadline: ${m.deadline || 'Not stated'}\\n  ${m.link}\\n  Why: ${m.reason}`).join('\\n\\n') : 'No strong matches this week.'; return [{json:{subject:'Monday Morning Opportunity Digest',body:`Opportunity matches for review\\n\\n${lines}\\n\\nVerify eligibility and deadlines at the original links before forwarding.`}}];"
      },
      "id": "gallery-23",
      "name": "Prepare Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        120
      ]
    },
