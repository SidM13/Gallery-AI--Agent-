      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ `Weekly Gallery Report - ${$now.toISODate()} - Ready for Review` }}",
        "message": "={{ $json.body }}",
        "options": {
          "sendTo": "={{ $('Configuration').item.json.ownerEmail }}"
        }
