    {
      "parameters": {
        "jsCode": "const rows = n => $(n).all().map(x=>x.json); return [{json:{periodEnding:$now.toISODate(),artists:rows('Read Artists'),collectors:rows('Read Collectors'),artworks:rows('Read Artworks'),sales:rows('Read Sales'),opportunities:rows('Read Opportunities'),calendar:$input.all().map(x=>x.json)}}];"
      },
      "id": "gallery-46",
      "name": "Bundle Weekly Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').item.json.ollamaUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: $('Configuration').item.json.model, stream: false, think: false, format: 'json', prompt: `Act as a careful gallery director. Summarize only the supplied data. Distinguish totals from this-week activity when dates allow it. Highlight new additions, sales, upcoming deadlines/events, inventory risks, and exactly 3 practical actions. Return JSON only: {\"subject\":\"\",\"body\":\"plain text\"}. Data: ${JSON.stringify($json)}` } }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "gallery-47",
      "name": "Write Weekly Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.response ?? $json.data?.response;\nif (!raw) throw new Error('Ollama returned no response');\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch { parsed = {}; }\nif (!parsed.subject || !parsed.body) {\n  const d = $('Bundle Weekly Data').item.json;\n  const money = n => new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'}).format(Number(n||0));\n  const revenue = d.sales.reduce((sum,s)=>sum+Number(s.Price||0),0);\n  const available = d.artworks.filter(a=>a.Status==='Available');\n  const deadlines = d.opportunities.filter(o=>o.Status!=='Closed');\n  parsed = {\n    subject: `Weekly Gallery Report - ${d.periodEnding}`,\n    body: `DEMO WEEKLY GALLERY REPORT\\nPeriod ending: ${d.periodEnding}\\n\\nSnapshot\\n- Artists: ${d.artists.length}\\n- Collectors: ${d.collectors.length}\\n- Artworks: ${d.artworks.length} (${available.length} available)\\n- Recorded sales: ${d.sales.length}, totaling ${money(revenue)}\\n- Open opportunities: ${deadlines.length}\\n- Upcoming calendar events: ${d.calendar.filter(e=>Object.keys(e).length).length}\\n\\nHighlights\\n- New demo artist: ${d.artists[0]?.Name || 'None'}\\n- Demo artwork: ${d.artworks[0]?.Title || 'None'} at ${money(d.artworks[0]?.Price)}\\n- Opportunity: ${deadlines[0]?.Title || 'None'}${deadlines[0]?.Deadline ? ` (deadline ${deadlines[0].Deadline})` : ''}\\n\\nRecommended actions\\n1. Review the available artwork and confirm its gallery presentation details.\\n2. Review the open opportunity and prepare application materials before the deadline.\\n3. Follow up with the demo collector about their stated style and budget.\\n\\nThis email was generated by the local n8n + Qwen demo workflow using clearly labeled fictional data.`\n  };\n}\nreturn [{ json: parsed }];"
      },
      "id": "gallery-48",
      "name": "Parse Weekly Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        120
      ]
    },
