    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').item.json.ollamaUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: $('Configuration').item.json.model, stream: false, think: false, format: 'json', prompt: `Write a warm, professional gallery application acknowledgement. It must not imply acceptance or representation. State that the team will review the portfolio and follow up. Return JSON only: {\"subject\":\"...\",\"body\":\"plain text...\"}. Artist: ${JSON.stringify($('Normalize Application').item.json)} Summary: ${$('Parse Summary').item.json.summary}` } }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "gallery-7",
      "name": "Write Welcome Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.response ?? $json.data?.response;\nif (!raw) throw new Error('Ollama returned no response');\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch { throw new Error('Ollama response was not valid JSON: ' + raw.slice(0, 200)); }\nif (!parsed.subject || !parsed.body) throw new Error('Draft requires subject and body');\nreturn [{ json: parsed }];"
      },
      "id": "gallery-8",
      "name": "Parse Welcome Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        0
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.body }}",
        "options": {
          "sendTo": "={{ $('Normalize Application').item.json.email }}"
        }
      },
